---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const { stack } = t;
---
<section class="stack section" id="stack" aria-labelledby="stack-heading">
  <div class="container">
    <header class="stack__header gsap-reveal">
      <span class="section-num mono">06 / <span data-i18n="nav.stack">{t.nav.stack}</span></span>
      <h2 id="stack-heading" class="section-h" data-i18n="stack.heading">{stack.heading}</h2>
      <p class="section-sub" data-i18n="stack.sub">{stack.sub}</p>
    </header>

    <div class="stack__layout">
      <div class="stack__blocks gsap-stagger">
        {stack.blocks.map((block, i) => (
          <div class="block">
            <header class="block__head">
              <span class="block__num mono">{`0${i + 1}`}</span>
              <span class="block__label" data-i18n={`stack.blocks.${i}.label`}>{block.label}</span>
            </header>
            <ul class="block__items">
              {block.items.map((item, ii) => (
                <li data-i18n={`stack.blocks.${i}.items.${ii}`}>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <aside class="anti gsap-reveal">
        <header class="anti__head">
          <span class="mono anti__tag">— Anti-patterns</span>
          <h3 data-i18n="stack.antiPatterns.title">{stack.antiPatterns.title}</h3>
        </header>
        <ul class="anti__list">
          {stack.antiPatterns.items.map((item, i) => (
            <li data-i18n={`stack.antiPatterns.items.${i}`}>{item}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
.stack {
  background: var(--c-bg);
  border-top: 1px solid var(--c-line);
}

.stack__header {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  max-width: 640px;
  margin-bottom: var(--sp-10);
}
.section-num {
  color: var(--c-brand);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: var(--text-label);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.section-num::before {
  content: '';
  display: inline-block;
  width: 18px;
  height: 1px;
  background: var(--c-brand);
}

.stack__layout {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: var(--sp-8);
  align-items: start;
}

/* Editorial blocks — no cards, just typography */
.stack__blocks {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  border-top: 1px solid var(--c-line);
  border-left: 1px solid var(--c-line);
}
.block {
  padding: var(--sp-4) var(--sp-4) var(--sp-5);
  border-right: 1px solid var(--c-line);
  border-bottom: 1px solid var(--c-line);
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  transition: background 0.25s var(--ease-out-quart);
}
.block:hover { background: var(--c-surface); }

.block__head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding-bottom: var(--sp-1);
  border-bottom: 1px dashed var(--c-line);
}
.block__num {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: var(--c-brand);
}
.block__label {
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--c-warm);
  letter-spacing: -0.01em;
}

.block__items {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.block__items li {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  color: var(--c-ink-2);
  letter-spacing: -0.005em;
  line-height: 1.55;
  position: relative;
  padding-left: 14px;
}
.block__items li::before {
  content: '›';
  position: absolute;
  left: 0;
  top: 0;
  color: var(--c-brand);
  font-family: var(--font-mono);
  opacity: 0.7;
}

/* Anti-patterns */
.anti {
  background: var(--c-surface);
  border: 1px solid var(--c-line);
  border-left: 2px solid var(--c-brand);
  border-radius: var(--r-card);
  padding: var(--sp-4);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}
.anti__head { display: flex; flex-direction: column; gap: 6px; }
.anti__tag {
  font-size: 0.625rem;
  letter-spacing: 0.12em;
  color: var(--c-brand);
  text-transform: uppercase;
}
.anti__head h3 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--c-warm);
  letter-spacing: -0.018em;
}

.anti__list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.anti__list li {
  font-size: var(--text-small);
  color: var(--c-ink-2);
  line-height: 1.55;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding-bottom: 10px;
  border-bottom: 1px dashed var(--c-line);
}
.anti__list li:last-child { border-bottom: 0; padding-bottom: 0; }
.anti__list li::before {
  content: '×';
  flex-shrink: 0;
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--c-brand);
  line-height: 1;
  margin-top: 1px;
}

@media (max-width: 980px) {
  .stack__layout { grid-template-columns: 1fr; gap: var(--sp-4); }
}
@media (max-width: 560px) {
  .stack__blocks { grid-template-columns: 1fr; }
}
</style>
