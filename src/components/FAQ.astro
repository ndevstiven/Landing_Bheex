---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const { faq } = t;
---
<section class="faq section" id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <header class="faq__header gsap-reveal">
      <span class="section-num mono">07 / <span data-i18n="faq.eyebrow">FAQ</span></span>
      <h2 id="faq-heading" class="section-h" data-i18n="faq.heading">{faq.heading}</h2>
      <p class="section-sub" data-i18n="faq.sub">{faq.sub}</p>
    </header>

    <ol class="faq__list gsap-stagger" role="list">
      {faq.items.map((item, i) => (
        <li class="faq__item">
          <details>
            <summary class="faq__q">
              <span class="faq__num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="faq__q-text" data-i18n={`faq.items.${i}.q`}>{item.q}</span>
              <span class="faq__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"/>
                  <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
              </span>
            </summary>
            <div class="faq__a">
              <p data-i18n={`faq.items.${i}.a`}>{item.a}</p>
            </div>
          </details>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
.faq {
  background: var(--c-bg);
  border-top: 1px solid var(--c-line);
}

.faq__header {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  max-width: 640px;
  margin-bottom: var(--sp-10);
}

.faq__list {
  list-style: none;
  display: flex;
  flex-direction: column;
}

.faq__item {
  border-top: 1px solid var(--c-line);
}
.faq__item:last-child { border-bottom: 1px solid var(--c-line); }

.faq__item details { padding: 0; }

.faq__q {
  display: grid;
  grid-template-columns: 60px 1fr 32px;
  gap: var(--sp-3);
  align-items: center;
  padding: var(--sp-4) 0;
  cursor: pointer;
  list-style: none;
  transition: color 0.2s;
  user-select: none;
}
.faq__q::-webkit-details-marker { display: none; }
.faq__q:hover { color: var(--c-brand); }

.faq__num {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  color: var(--c-brand);
  font-weight: 500;
  letter-spacing: -0.01em;
}

.faq__q-text {
  font-family: var(--font-display);
  font-size: clamp(1.0625rem, 1.6vw, 1.375rem);
  font-weight: 600;
  color: var(--c-ink);
  letter-spacing: -0.022em;
  line-height: 1.25;
}
.faq__q:hover .faq__q-text { color: var(--c-brand); }

.faq__icon {
  display: grid;
  place-items: center;
  width: 32px; height: 32px;
  color: var(--c-ink);
  border: 1px solid var(--c-line-2);
  border-radius: 50%;
  transition: transform 0.3s var(--ease-out-quart), border-color 0.2s, color 0.2s;
}
details[open] .faq__icon {
  transform: rotate(45deg);
  border-color: var(--c-brand);
  color: var(--c-brand);
}

.faq__a {
  padding: 0 0 var(--sp-4) calc(60px + var(--sp-3));
  animation: faqOpen 0.4s var(--ease-out-quart);
}
.faq__a p {
  font-size: var(--text-body);
  color: var(--c-ink-2);
  line-height: 1.65;
  max-width: 64ch;
}

@keyframes faqOpen {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .faq__a { animation: none; }
  .faq__icon { transition: none; }
}

@media (max-width: 640px) {
  .faq__q { grid-template-columns: 40px 1fr 28px; gap: var(--sp-2); }
  .faq__a { padding-left: calc(40px + var(--sp-2)); }
}
</style>
