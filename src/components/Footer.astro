---
<footer class="footer" aria-label="Footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" aria-label="Bheex.ai">
        <picture>
          <source srcset="/assets/logos/optimized/logo-positivo.webp" type="image/webp" />
          <img src="/assets/logos/optimized/logo-positivo.png" alt="Bheex.ai" width="97" height="32" loading="lazy" decoding="async" />
        </picture>
      </a>
      <p class="footer__tagline" data-i18n="footer.tagline">{footer.tagline}</p>

      <ul class="footer__social" aria-label="Redes sociales">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              title={s.name}
            >
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" set:html={s.svg} />
            </a>
          </li>
        ))}
      </ul>
    </div>
    <nav class="footer__nav" aria-label="Footer navigation">
      <div class="footer__col">
        <p class="footer__col-title" data-i18n="footer.product">{footer.product}</p>
        {footer.navProduct.map((label, i) => (
          <a href={navLinks[i]?.href || '#'} data-i18n={`footer.navProduct.${i}`}>{label}</a>
        ))}
      </div>
      <div class="footer__col">
        <p class="footer__col-title" data-i18n="footer.company">{footer.company}</p>
        {footer.navCompany.map((label, i) => (
          <a href="#" data-i18n={`footer.navCompany.${i}`}>{label}</a>
        ))}
      </div>
    </nav>
  </div>
  <div class="container footer__bottom">
    <p>&copy; {year} Bheex.ai. <span data-i18n="footer.legal">{footer.legal}</span></p>
    <div class="footer__legal">
      <a href="#" data-i18n="footer.privacy">{footer.privacy}</a>
      <a href="#" data-i18n="footer.terms">{footer.terms}</a>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--c-surface);
  border-top: 1px solid var(--c-border);
  padding-top: var(--sp-12);
}
.footer__inner {
  display: flex;
  gap: var(--sp-12);
  padding-bottom: var(--sp-8);
  border-bottom: 1px solid var(--c-border);
}
.footer__brand {
  flex: 1.5;
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}
.footer__tagline {
  font-size: var(--text-small);
  color: var(--c-ink-3);
  line-height: 1.65;
  max-width: 28ch;
  white-space: pre-line;
}

.footer__social {
  list-style: none !important;
  padding: 0 !important;
  margin: var(--sp-2) 0 0 !important;
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap;
  gap: 10px;
}
.footer__social > li {
  list-style: none;
  padding: 0;
  margin: 0;
  display: inline-flex;
}
.footer__social > li::marker { display: none; content: ''; }
.footer__social a {
  width: 40px;
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--c-bg-2);
  color: var(--c-ink);
  border: 1px solid var(--c-line);
  transition: background 0.25s var(--ease-out-quart),
              color 0.25s var(--ease-out-quart),
              border-color 0.25s var(--ease-out-quart),
              transform 0.25s var(--ease-out-quart);
}
.footer__social a:hover {
  background: var(--c-ink);
  color: #FFFFFF;
  border-color: var(--c-ink);
  transform: translateY(-3px) scale(1.05);
  box-shadow: 0 8px 20px -6px rgba(21,17,13,0.25);
}
.footer__social svg { display: block; }

.footer__nav { display: flex; gap: var(--sp-8); }
.footer__col {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}
.footer__col-title {
  font-family: var(--font-display);
  font-size: var(--text-small);
  font-weight: 600;
  color: var(--c-warm);
  margin-bottom: var(--sp-1);
}
.footer__col a {
  font-size: var(--text-small);
  color: var(--c-ink-3);
  transition: color 0.2s;
}
.footer__col a:hover { color: var(--c-brand); }
.footer__bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-block: var(--sp-3);
  font-size: 0.75rem;
  color: var(--c-muted);
}
.footer__legal { display: flex; gap: var(--sp-3); }
.footer__legal a { color: var(--c-muted); transition: color 0.2s; }
.footer__legal a:hover { color: var(--c-warm); }

@media (max-width: 640px) {
  .footer__inner { flex-direction: column; gap: var(--sp-6); }
  .footer__bottom { flex-direction: column; gap: var(--sp-2); text-align: center; }
}
</style>
