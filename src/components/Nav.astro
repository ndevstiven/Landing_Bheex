---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const { nav } = t;
---
<header class="nav" id="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo" aria-label="Bheex.ai inicio">
      <picture>
        <source srcset="/assets/logos/optimized/logo-positivo.webp" type="image/webp" />
        <img src="/assets/logos/optimized/logo-positivo.png" alt="Bheex.ai" width="97" height="32" loading="eager" decoding="async" />
      </picture>
    </a>

    <nav class="nav__links" aria-label="Navegación principal">
      <a href="#capacidades" data-i18n="nav.capabilities">{nav.capabilities}</a>
      <a href="#servicios" data-i18n="nav.services">{nav.services}</a>
      <a href="#proceso" data-i18n="nav.process">{nav.process}</a>
      <a href="#casos" data-i18n="nav.cases">{nav.cases}</a>
      <a href="#stack" data-i18n="nav.stack">{nav.stack}</a>
    </nav>

    <a href="#contacto" class="btn btn--primary nav__cta" data-i18n="nav.cta">{nav.cta}</a>

    <button class="nav__burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__mobile" id="nav-mobile" hidden>
    <a href="#capacidades" data-i18n="nav.capabilities">{nav.capabilities}</a>
    <a href="#servicios" data-i18n="nav.services">{nav.services}</a>
    <a href="#proceso" data-i18n="nav.process">{nav.process}</a>
    <a href="#casos" data-i18n="nav.cases">{nav.cases}</a>
    <a href="#stack" data-i18n="nav.stack">{nav.stack}</a>
    <a href="#contacto" class="btn btn--primary" data-i18n="nav.cta">{nav.cta}</a>
  </div>
</header>

<style>
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: var(--z-sticky);
  padding-block: var(--sp-2);
  transition: background 0.35s var(--ease-out-quart),
              backdrop-filter 0.35s,
              border-color 0.35s,
              box-shadow 0.35s;
  border-bottom: 1px solid transparent;
}
.nav.scrolled {
  background: rgba(247,244,238,0.88);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
  border-bottom-color: var(--c-line);
}

.nav__inner {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
}
.nav__logo img { height: 32px; width: auto; }

.nav__links {
  display: flex;
  gap: var(--sp-3);
  margin-left: auto;
}
.nav__links a {
  font-size: var(--text-small);
  font-weight: 500;
  color: var(--c-ink-2);
  transition: color 0.2s;
  position: relative;
  padding-block: 4px;
}
.nav__links a::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 1px;
  background: var(--c-brand);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s var(--ease-out-quart);
}
.nav__links a:hover { color: var(--c-ink); }
.nav__links a:hover::after { transform: scaleX(1); }

.nav__cta { margin-left: var(--sp-2); }

.nav__burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  margin-left: auto;
  padding: var(--sp-1);
}
.nav__burger span {
  display: block;
  width: 22px; height: 2px;
  background: var(--c-ink);
  transition: transform 0.2s, opacity 0.2s;
  border-radius: 1px;
}

.nav__mobile {
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4) var(--sp-4);
  background: rgba(247,244,238,0.98);
  backdrop-filter: blur(20px);
  border-top: 1px solid var(--c-line);
  display: none;
}
.nav__mobile:not([hidden]) { display: flex; }
.nav__mobile a {
  font-size: 1.125rem;
  font-weight: 500;
  color: var(--c-ink);
}
.nav__mobile .btn { width: fit-content; }

@media (max-width: 920px) {
  .nav__links { display: none; }
  .nav__cta { display: none; }
  .nav__burger { display: flex; }
}

/* ─── Global buttons ─── */
:global(.btn) {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-display);
  font-size: var(--text-small);
  font-weight: 500;
  letter-spacing: -0.005em;
  padding: 11px 22px;
  border-radius: var(--r-btn);
  transition: background 0.2s, color 0.2s, border-color 0.2s, box-shadow 0.2s;
  white-space: nowrap;
  border: 1px solid transparent;
}
:global(.btn--primary) {
  background: var(--c-ink);
  color: var(--c-bg);
  border-color: var(--c-ink);
}
:global(.btn--primary:hover) {
  background: var(--c-brand);
  border-color: var(--c-brand);
  color: #FFFFFF;
  box-shadow: 0 8px 24px -8px rgba(229,95,26,0.4);
}
:global(.btn--ghost) {
  background: transparent;
  color: var(--c-ink);
  border-color: var(--c-line-2);
}
:global(.btn--ghost:hover) {
  background: var(--c-surface);
  border-color: var(--c-ink);
}
</style>

<script>
const nav = document.getElementById('nav')!;
const burger = nav.querySelector('.nav__burger') as HTMLButtonElement;
const mobileMenu = document.getElementById('nav-mobile') as HTMLElement;

window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 24);
}, { passive: true });

burger.addEventListener('click', () => {
  const isOpen = !mobileMenu.hidden;
  mobileMenu.hidden = isOpen;
  burger.setAttribute('aria-expanded', String(!isOpen));
});

mobileMenu.querySelectorAll('a').forEach(a => {
  a.addEventListener('click', () => {
    mobileMenu.hidden = true;
    burger.setAttribute('aria-expanded', 'false');
  });
});
</script>
