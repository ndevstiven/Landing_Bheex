---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const { nav } = t;
---
<header class="nav" id="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo" aria-label="Bheex.ai inicio">
      <img src="/assets/logos/Bheex.Logos.principal.png" alt="Bheex.ai" height="36" />
    </a>

    <nav class="nav__links" aria-label="Navegación principal">
      <a href="#agentes" data-i18n="nav.agents">{nav.agents}</a>
      <a href="#como-funciona" data-i18n="nav.howItWorks">{nav.howItWorks}</a>
      <a href="#resultados" data-i18n="nav.results">{nav.results}</a>
      <a href="#contacto" data-i18n="nav.contact">{nav.contact}</a>
    </nav>

    <a href="#contacto" class="btn btn--primary nav__cta" data-i18n="nav.cta">{nav.cta}</a>

    <button class="nav__burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__mobile" id="nav-mobile" hidden>
    <a href="#agentes" data-i18n="nav.agents">{nav.agents}</a>
    <a href="#como-funciona" data-i18n="nav.howItWorks">{nav.howItWorks}</a>
    <a href="#resultados" data-i18n="nav.results">{nav.results}</a>
    <a href="#contacto" data-i18n="nav.contact">{nav.contact}</a>
    <a href="#contacto" class="btn btn--primary" data-i18n="nav.cta">{nav.cta}</a>
  </div>
</header>

<style>
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: var(--z-sticky);
  padding-block: var(--sp-2);
  transition: background 0.35s var(--ease-out-quart),
              backdrop-filter 0.35s,
              border-color 0.35s;
  border-bottom: 1px solid transparent;
}
.nav.scrolled {
  background: rgba(13,13,13,0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom-color: var(--c-border);
}

.nav__inner {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
}
.nav__logo img { height: 36px; width: auto; }

.nav__links {
  display: flex;
  gap: var(--sp-4);
  margin-left: auto;
}
.nav__links a {
  font-size: var(--text-small);
  font-weight: 500;
  color: rgba(240,235,227,0.7);
  transition: color 0.2s;
  position: relative;
}
.nav__links a::after {
  content: '';
  position: absolute;
  bottom: -2px; left: 0; right: 0;
  height: 1px;
  background: var(--c-brand);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.25s var(--ease-out-quart);
}
.nav__links a:hover { color: var(--c-warm); }
.nav__links a:hover::after { transform: scaleX(1); }

.nav__cta { margin-left: var(--sp-3); }

.nav__burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  margin-left: auto;
  padding: var(--sp-1);
}
.nav__burger span {
  display: block;
  width: 22px; height: 2px;
  background: var(--c-warm);
  transition: transform 0.2s, opacity 0.2s;
  border-radius: 1px;
}

.nav__mobile {
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4) var(--sp-4);
  background: rgba(13,13,13,0.97);
  border-top: 1px solid var(--c-border);
  display: none;
}
.nav__mobile:not([hidden]) { display: flex; }
.nav__mobile a {
  font-size: 1.125rem;
  font-weight: 500;
  color: var(--c-warm);
}
.nav__mobile .btn { width: fit-content; }

@media (max-width: 767px) {
  .nav__links { display: none; }
  .nav__cta { display: none; }
  .nav__burger { display: flex; }
}

/* ─── Global buttons ─── */
:global(.btn) {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  font-family: var(--font-display);
  font-size: var(--text-small);
  font-weight: 500;
  letter-spacing: 0.01em;
  padding: 12px 24px;
  border-radius: var(--r-btn);
  transition: filter 0.2s, box-shadow 0.2s, background 0.2s;
  white-space: nowrap;
}
:global(.btn--primary) {
  background: var(--c-brand);
  color: #0D0D0D;
}
:global(.btn--primary:hover) {
  filter: brightness(1.1);
  box-shadow: 0 0 24px rgba(246,112,41,0.4);
}
:global(.btn--ghost) {
  background: transparent;
  color: var(--c-brand);
  border: 1px solid var(--c-brand);
}
:global(.btn--ghost:hover) {
  background: rgba(246,112,41,0.08);
}
</style>

<script>
const nav = document.getElementById('nav')!;
const burger = nav.querySelector('.nav__burger') as HTMLButtonElement;
const mobileMenu = document.getElementById('nav-mobile') as HTMLElement;

window.addEventListener('scroll', () => {
  nav.classList.toggle('scrolled', window.scrollY > 24);
}, { passive: true });

burger.addEventListener('click', () => {
  const isOpen = !mobileMenu.hidden;
  mobileMenu.hidden = isOpen;
  burger.setAttribute('aria-expanded', String(!isOpen));
});

mobileMenu.querySelectorAll('a').forEach(a => {
  a.addEventListener('click', () => {
    mobileMenu.hidden = true;
    burger.setAttribute('aria-expanded', 'false');
  });
});
</script>
