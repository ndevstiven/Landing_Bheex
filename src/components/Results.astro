---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const { results } = t;
---
<section class="results section" id="casos" aria-labelledby="results-heading">
  <div class="container">
    <header class="results__header gsap-reveal">
      <span class="section-num mono">05 / <span data-i18n="nav.cases">{t.nav.cases}</span></span>
      <h2 id="results-heading" class="section-h" data-i18n="results.heading">{results.heading}</h2>
      <p class="section-sub" data-i18n="results.sub">{results.sub}</p>
    </header>

    <div class="cases gsap-stagger">
      {results.cases.map((c, i) => (
        <article class="case">
          <header class="case__meta">
            <span class="mono case__index">Case · {String(i + 1).padStart(2, '0')}</span>
            <span class="case__industry" data-i18n={`results.cases.${i}.industry`}>{c.industry}</span>
          </header>

          <div class="case__metric">
            <span class="case__value">{c.metric}</span>
            <span class="case__label" data-i18n={`results.cases.${i}.metricLabel`}>{c.metricLabel}</span>
          </div>

          <div class="case__detail">
            <div class="case__row">
              <span class="case__row-label mono">Problema</span>
              <p class="case__row-text" data-i18n={`results.cases.${i}.problem`}>{c.problem}</p>
            </div>
            <div class="case__row">
              <span class="case__row-label mono">Solución</span>
              <p class="case__row-text" data-i18n={`results.cases.${i}.solution`}>{c.solution}</p>
            </div>
            <div class="case__row">
              <span class="case__row-label mono">Métricas</span>
              <p class="case__row-text case__row-text--brand" data-i18n={`results.cases.${i}.secondary`}>{c.secondary}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <blockquote class="results__quote gsap-reveal">
      <p data-i18n="results.quote">{results.quote}</p>
      <cite class="results__cite">
        <span class="results__cite-name" data-i18n="results.quoteName">{results.quoteName}</span>
        <span class="results__cite-title mono" data-i18n="results.quoteTitle">{results.quoteTitle}</span>
      </cite>
    </blockquote>
  </div>
</section>

<style>
.results {
  background: var(--c-bg);
  border-top: 1px solid var(--c-line);
}

.results__header {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  max-width: 640px;
  margin-bottom: var(--sp-10);
}
.section-num {
  color: var(--c-brand);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: var(--text-label);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.section-num::before {
  content: '';
  display: inline-block;
  width: 18px;
  height: 1px;
  background: var(--c-brand);
}

.cases {
  display: flex;
  flex-direction: column;
}

.case {
  display: grid;
  grid-template-columns: 0.7fr 0.6fr 1.5fr;
  gap: var(--sp-6);
  padding: var(--sp-8) 0;
  border-bottom: 1px solid var(--c-line);
  align-items: start;
  transition: background 0.3s var(--ease-out-quart);
}
.case:first-child { border-top: 1px solid var(--c-line); }
.case:hover { background: linear-gradient(to right, rgba(246,112,41,0.025), transparent 60%); }

.case__meta {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}
.case__index {
  color: var(--c-brand);
  font-size: var(--text-label);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.case__industry {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--c-warm);
  letter-spacing: -0.022em;
  line-height: 1.2;
}

.case__metric {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-left: var(--sp-4);
  border-left: 1px solid var(--c-line);
}
.case__value {
  font-family: var(--font-display);
  font-size: clamp(3rem, 6vw, 5rem);
  font-weight: 600;
  color: var(--c-brand);
  letter-spacing: -0.05em;
  line-height: 0.9;
  font-feature-settings: 'tnum';
}
.case__label {
  font-family: var(--font-body);
  font-size: var(--text-small);
  color: var(--c-ink-3);
  line-height: 1.4;
  max-width: 22ch;
  margin-top: 4px;
}

.case__detail {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  padding-left: var(--sp-4);
  border-left: 1px solid var(--c-line);
}
.case__row {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: var(--sp-3);
  padding-bottom: 12px;
  border-bottom: 1px dashed var(--c-line);
}
.case__row:last-child { border-bottom: 0; padding-bottom: 0; }

.case__row-label {
  font-size: 0.625rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--c-muted);
  padding-top: 3px;
}
.case__row-text {
  font-size: var(--text-small);
  color: var(--c-ink-2);
  line-height: 1.6;
}
.case__row-text--brand {
  color: var(--c-brand);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0;
}

/* Testimonial */
.results__quote {
  margin-top: var(--sp-10);
  padding: var(--sp-8) var(--sp-6);
  background: var(--c-surface);
  border: 1px solid var(--c-line);
  border-radius: var(--r-card);
  display: flex;
  flex-direction: column;
  gap: var(--sp-4);
  position: relative;
  overflow: hidden;
}
.results__quote::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 3px;
  height: 100%;
  background: var(--c-brand);
}
.results__quote::after {
  content: '"';
  position: absolute;
  top: 12px; right: 24px;
  font-family: var(--font-display);
  font-size: 8rem;
  font-weight: 700;
  color: var(--c-brand);
  opacity: 0.06;
  line-height: 1;
}

.results__quote p {
  font-family: var(--font-display);
  font-size: clamp(1.125rem, 1.8vw, 1.625rem);
  font-weight: 400;
  color: var(--c-warm);
  line-height: 1.45;
  letter-spacing: -0.018em;
  max-width: 82ch;
}
.results__cite {
  font-style: normal;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.results__cite-name {
  font-family: var(--font-display);
  font-weight: 600;
  color: var(--c-warm);
  font-size: var(--text-small);
}
.results__cite-title {
  font-size: 0.6875rem;
  letter-spacing: 0.08em;
  color: var(--c-muted);
  text-transform: uppercase;
}

@media (max-width: 980px) {
  .case {
    grid-template-columns: 1fr;
    gap: var(--sp-3);
  }
  .case__metric, .case__detail {
    padding-left: 0;
    border-left: 0;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--c-line);
  }
}
@media (max-width: 560px) {
  .case__row { grid-template-columns: 1fr; gap: 4px; }
  .results__quote { padding: var(--sp-4); }
}
</style>
