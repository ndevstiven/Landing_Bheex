---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const stats = t.results.metrics;
---
<section class="proof" aria-label="Key metrics">
  <div class="proof__slash tr" aria-hidden="true"></div>
  <div class="container proof__inner">
    {stats.map((s, i) => (
      <div class="proof__item gsap-reveal" style={`--delay: ${i * 80}ms`}>
        <span class="proof__value">{s.value}{s.suffix}</span>
        <span class="proof__label" data-i18n={`results.metrics.${i}.label`}>{s.label}</span>
      </div>
    ))}
  </div>
  <div class="proof__slash bl" aria-hidden="true"></div>
</section>

<style>
.proof {
  background: var(--c-surface);
  border-top: 1px solid var(--c-border);
  border-bottom: 1px solid var(--c-border);
  position: relative;
  padding-block: var(--sp-8);
  overflow: hidden;
}
.proof__slash {
  position: absolute;
  width: 0; height: 0;
  border-style: solid;
}
.proof__slash.tr {
  top: 0; right: 0;
  border-width: 0 56px 56px 0;
  border-color: transparent var(--c-brand) transparent transparent;
}
.proof__slash.bl {
  bottom: 0; left: 0;
  border-width: 56px 0 0 56px;
  border-color: transparent transparent transparent var(--c-brand);
}

.proof__inner {
  display: flex;
  justify-content: space-between;
  gap: var(--sp-6);
  flex-wrap: wrap;
}

.proof__item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-width: 140px;
}
.proof__value {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 700;
  color: var(--c-brand);
  line-height: 1;
  letter-spacing: -0.03em;
}
.proof__label {
  font-size: var(--text-small);
  color: rgba(240,235,227,0.58);
  line-height: 1.4;
  max-width: 18ch;
}
</style>
