---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const { chat } = t;

// EN strings inlined so client can swap to English at runtime without fetching
const chatEn = {
  buttonLabel: "Talk to the team",
  title: "Bheex.ai team",
  subtitle: "We reply within minutes",
  welcomeMsg: "Hi. I'm part of the Bheex.ai team. What process or system are you thinking of building? Below are the questions we get the most — or message us directly.",
  quickRepliesTitle: "Common questions:",
  quickReplies: [
    { q: "How much does it cost?", intent: "cost" },
    { q: "How long does it take?", intent: "timeline" },
    { q: "Who owns the IP?", intent: "ip" },
    { q: "How do we start?", intent: "start" },
    { q: "What stack do you use?", intent: "stack" },
    { q: "Do you handle sensitive data?", intent: "data" },
    { q: "Post-deploy support?", intent: "support" },
    { q: "Why not Make/Zapier?", intent: "vs" },
  ],
  intents: {
    cost: "Depends on scope. Fixed-scope projects average USD 18K–60K. Monthly retainer USD 12K–28K. Technical audit is free with no commitment.",
    timeline: "Fixed-scope: 4–8 weeks depending on integrations. Staging from day 10. Technical audit delivered in 7 days.",
    ip: "Yours. 100%. All code, prompts, configurations, and data are yours. Deploy to your cloud if you prefer.",
    start: "Three paths: 1) Free 30-min technical audit (most common), 2) Fixed-scope project, 3) Dedicated team on retainer. Fill the form above or write us directly.",
    stack: "LLMs: Claude Sonnet 4.6, Opus 4.7, GPT-4o, Llama 3 / Mistral self-hosted. Backend: Node.js, Python, Go. Data: PostgreSQL, MongoDB, Redis, BigQuery. Our own orchestration with vector + relational memory.",
    data: "Yes. We sign NDA before kickoff. Experience with financial, health, private data under GDPR/CCPA. On-prem or VPC deploy available.",
    support: "30 days hypercare after deploy. Then: optional retainer, full handoff to your team (docs + training), or both in phases.",
    vs: "Make/Zapier works for simple flows. For agents that orchestrate tools, hold context, and have production fallback, you need architecture. Internal build viable if you have 2+ senior AI engineers.",
    team: "We're a team of AI engineers and devs with mission-critical production experience. We ship measured systems, not demos.",
    cases: "Active clients in fintech (78% tickets resolved no-human), B2B SaaS (3.4x more qualified leads), omnichannel retail (40h/wk saved).",
  },
  fallback: "I don't have an exact answer from chat. Fastest path: book the free 30-min technical audit (top form) or write contact@bheex.ai. We reply within 24h.",
};
---
<div class="chat-widget" id="chat-widget">
  <div class="chat-panel" id="chat-panel" hidden aria-label="Chat with Bheex.ai team" role="dialog" aria-modal="true">
    <div class="cp__header">
      <div class="cp__avatar">
        <img src="/assets/logos/optimized/isotipo.png" alt="Bheex.ai" width="28" height="28" />
      </div>
      <div class="cp__meta">
        <p class="cp__title" data-i18n="chat.title">{chat.title}</p>
        <p class="cp__sub"><span class="dot"></span><span data-i18n="chat.subtitle">{chat.subtitle}</span></p>
      </div>
      <button class="cp__close" id="chat-close" aria-label="Close chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="cp__messages" id="cp-messages" aria-live="polite">
      <!-- Messages + quick replies injected by JS -->
    </div>
    <div class="cp__typing" id="cp-typing" hidden aria-live="polite">
      <span></span><span></span><span></span>
    </div>
    <form class="cp__input-row" id="chat-form" novalidate>
      <input
        type="text"
        id="chat-input"
        class="cp__input"
        placeholder={chat.placeholder}
        autocomplete="off"
        maxlength="500"
        aria-label={chat.placeholder}
        data-i18n-placeholder="chat.placeholder"
      />
      <button type="submit" class="cp__send" aria-label={chat.send}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>
  </div>

  <button class="chat-fab" id="chat-fab" aria-label={chat.buttonLabel} aria-expanded="false">
    <span class="fab__icon fab__icon--open" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </span>
    <span class="fab__icon fab__icon--close" aria-hidden="true" hidden>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </span>
    <span class="fab__label" data-i18n="chat.buttonLabel">{chat.buttonLabel}</span>
    <span class="fab__pulse" aria-hidden="true"></span>
  </button>
</div>

<script define:vars={{ chatEs: chat, chatEn }}>
const panel = document.getElementById('chat-panel');
const fab = document.getElementById('chat-fab');
const closeBtn = document.getElementById('chat-close');
const form = document.getElementById('chat-form');
const input = document.getElementById('chat-input');
const messagesEl = document.getElementById('cp-messages');
const typingEl = document.getElementById('cp-typing');
const iconOpen = fab?.querySelector('.fab__icon--open');
const iconClose = fab?.querySelector('.fab__icon--close');

// Bilingual: pick locale by browser at runtime
const isEn = (navigator.language || 'es').toLowerCase().startsWith('en');
const C = isEn ? chatEn : chatEs;

let isOpen = false;
let initialized = false;

function scrollBottom() {
  if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
}

function escapeHTML(s) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function addMessage(role, text) {
  const div = document.createElement('div');
  div.className = `cm cm--${role}`;
  const safe = escapeHTML(text);
  div.innerHTML = role === 'agent'
    ? `<div class="cm__avatar"><img src="/assets/logos/optimized/isotipo.png" width="18" height="18" alt=""/></div><div class="cm__bubble">${safe}</div>`
    : `<div class="cm__bubble">${safe}</div>`;
  messagesEl?.appendChild(div);
  scrollBottom();
}

function renderQuickReplies() {
  const wrap = document.createElement('div');
  wrap.className = 'cm cm--agent cm--qr';
  const buttons = C.quickReplies.map(q =>
    `<button class="qr__btn" data-intent="${q.intent}">${escapeHTML(q.q)}</button>`
  ).join('');
  wrap.innerHTML = `
    <div class="cm__avatar"><img src="/assets/logos/optimized/isotipo.png" width="18" height="18" alt=""/></div>
    <div class="qr__box">
      <span class="qr__title">${escapeHTML(C.quickRepliesTitle)}</span>
      <div class="qr__grid">${buttons}</div>
    </div>
  `;
  messagesEl?.appendChild(wrap);
  wrap.querySelectorAll('.qr__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const intent = btn.getAttribute('data-intent');
      const text = btn.textContent || '';
      handleIntent(intent, text);
    });
  });
  scrollBottom();
}

function showTyping(show) {
  if (typingEl) typingEl.hidden = !show;
  scrollBottom();
}

function classifyIntent(text) {
  const t = text.toLowerCase();
  if (/(precio|cost|cuánto cuest|cuanto cuest|how much|fee|price|cobra|presupuest)/.test(t)) return 'cost';
  if (/(tiempo|cuánto tarda|cuanto tarda|how long|timeline|plazo|semanas|delivery)/.test(t)) return 'timeline';
  if (/(propiedad|ip\b|ownership|owns|owns the|copyright|patente)/.test(t)) return 'ip';
  if (/(empez|start|begin|kickoff|cómo iniciar|como iniciar|first step)/.test(t)) return 'start';
  if (/(stack|tecnolog|tech|model|claude|gpt|llama|backend|llm|tools)/.test(t)) return 'stack';
  if (/(nda|datos sensibles|sensitive|gdpr|hipaa|ccpa|privac|complianc|on-prem|vpc)/.test(t)) return 'data';
  if (/(soporte|support|hypercare|post deploy|post-deploy|handoff|maintenance)/.test(t)) return 'support';
  if (/(make|zapier|n8n|workflow|automatización visual|why not|por qué no|comparison|vs)/.test(t)) return 'vs';
  if (/(equipo|team|founders|fundador|engineers|background|quiénes son|quienes son)/.test(t)) return 'team';
  if (/(caso|case|cliente|reference|portfolio|examples|resultados|outcome)/.test(t)) return 'cases';
  return null;
}

function handleIntent(intent, label) {
  addMessage('user', label || C.quickReplies.find(q => q.intent === intent)?.q || intent);
  showTyping(true);
  setTimeout(() => {
    showTyping(false);
    const answer = C.intents[intent] || C.fallback;
    addMessage('agent', answer);
    setTimeout(renderQuickReplies, 400);
  }, 700 + Math.random() * 500);
}

function openChat() {
  panel.hidden = false;
  fab.setAttribute('aria-expanded', 'true');
  iconOpen.hidden = true;
  iconClose.hidden = false;
  isOpen = true;
  input?.focus();

  if (!initialized) {
    initialized = true;
    setTimeout(() => {
      addMessage('agent', C.welcomeMsg);
      setTimeout(renderQuickReplies, 600);
    }, 300);
  }
}

function closeChat() {
  panel.hidden = true;
  fab.setAttribute('aria-expanded', 'false');
  iconOpen.hidden = false;
  iconClose.hidden = true;
  isOpen = false;
}

fab?.addEventListener('click', () => isOpen ? closeChat() : openChat());
closeBtn?.addEventListener('click', closeChat);

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && isOpen) closeChat();
});

// Submit free-text — classify intent, fall back to generic answer
form?.addEventListener('submit', (e) => {
  e.preventDefault();
  const text = input?.value.trim();
  if (!text) return;

  addMessage('user', text);
  input.value = '';
  showTyping(true);

  setTimeout(() => {
    showTyping(false);
    const intent = classifyIntent(text);
    const answer = intent ? C.intents[intent] : C.fallback;
    addMessage('agent', answer);
    setTimeout(renderQuickReplies, 500);
  }, 700 + Math.random() * 500);
});
</script>

<style is:global>
.chat-widget {
  position: fixed;
  bottom: var(--sp-4);
  right: var(--sp-4);
  z-index: var(--z-modal);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--sp-2);
}

/* FAB */
.chat-fab {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--c-ink);
  color: var(--c-bg);
  padding: 14px 20px 14px 16px;
  border-radius: 50px;
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 4px 24px rgba(21,17,13,0.18), 0 1px 4px rgba(21,17,13,0.1);
  transition: transform 0.2s var(--ease-out-quart), box-shadow 0.2s, background 0.2s;
  position: relative;
}
.chat-fab:hover {
  background: var(--c-brand);
  transform: translateY(-2px);
  box-shadow: 0 6px 32px rgba(229,95,26,0.4), 0 2px 8px rgba(21,17,13,0.15);
}
.fab__icon { display: flex; }
.fab__pulse {
  position: absolute;
  top: -3px; right: -3px;
  width: 12px; height: 12px;
  border-radius: 50%;
  background: #16a34a;
  border: 2px solid var(--c-bg);
  animation: fabPulse 2.5s ease-in-out infinite;
}
@keyframes fabPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(22,163,74,0.5); }
  50% { box-shadow: 0 0 0 5px rgba(22,163,74,0); }
}
@media (prefers-reduced-motion: reduce) { .fab__pulse { animation: none; } }

/* Panel */
.chat-panel {
  width: 380px;
  max-width: calc(100vw - var(--sp-4) * 2);
  background: var(--c-surface);
  border: 1px solid var(--c-line-2);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(21,17,13,0.20), 0 4px 16px rgba(229,95,26,0.08);
  animation: panelIn 0.25s var(--ease-out-expo) both;
}
@keyframes panelIn {
  from { opacity: 0; transform: translateY(16px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
@media (prefers-reduced-motion: reduce) { .chat-panel { animation: none; } }

.cp__header {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: 14px var(--sp-3);
  background: var(--c-surface2);
  border-bottom: 1px solid var(--c-line);
}
.cp__avatar {
  width: 38px; height: 38px;
  border-radius: 50%;
  background: rgba(229,95,26,0.10);
  display: grid;
  place-items: center;
  border: 1px solid rgba(229,95,26,0.22);
  flex-shrink: 0;
}
.cp__title {
  font-family: var(--font-display);
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--c-ink);
}
.cp__sub {
  font-size: 0.6875rem;
  color: var(--c-muted);
  display: flex;
  align-items: center;
  gap: 5px;
}
.cp__sub .dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #16a34a;
  animation: dotPulse 2.2s ease-in-out infinite;
  flex-shrink: 0;
}
@keyframes dotPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(22,163,74,0.5); }
  50% { box-shadow: 0 0 0 4px rgba(22,163,74,0); }
}
@media (prefers-reduced-motion: reduce) { .cp__sub .dot { animation: none; } }

.cp__close {
  margin-left: auto;
  width: 28px; height: 28px;
  border-radius: 4px;
  background: var(--c-surface);
  border: 1px solid var(--c-line-2);
  color: var(--c-muted);
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s;
}
.cp__close:hover { color: var(--c-ink); border-color: var(--c-ink-3); }

.cp__messages {
  height: 360px;
  overflow-y: auto;
  padding: var(--sp-3);
  display: flex;
  flex-direction: column;
  gap: 10px;
  scroll-behavior: smooth;
}

.cm {
  display: flex;
  gap: 8px;
  animation: msgIn 0.22s var(--ease-out-quart) both;
}
@keyframes msgIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) { .cm { animation: none; } }

.cm--user { flex-direction: row-reverse; }
.cm__avatar {
  width: 24px; height: 24px;
  border-radius: 50%;
  background: rgba(229,95,26,0.10);
  display: grid;
  place-items: center;
  flex-shrink: 0;
  margin-top: 2px;
  border: 1px solid rgba(229,95,26,0.18);
}
.cm__bubble {
  max-width: 80%;
  padding: 9px 13px;
  border-radius: 12px;
  font-size: 0.8125rem;
  line-height: 1.55;
}
.cm--agent .cm__bubble {
  background: var(--c-surface2);
  border: 1px solid var(--c-line);
  color: var(--c-ink);
  border-bottom-left-radius: 3px;
}
.cm--user .cm__bubble {
  background: var(--c-ink);
  color: var(--c-bg);
  font-weight: 500;
  border-bottom-right-radius: 3px;
}

/* Quick replies */
.cm--qr .qr__box {
  background: var(--c-surface2);
  border: 1px solid var(--c-line);
  border-radius: 12px;
  border-bottom-left-radius: 3px;
  padding: 10px 12px;
  max-width: 92%;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.qr__title {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.06em;
  color: var(--c-muted);
  text-transform: uppercase;
}
.qr__grid {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.qr__btn {
  text-align: left;
  font-family: var(--font-body);
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--c-ink);
  background: var(--c-surface);
  border: 1px solid var(--c-line);
  padding: 8px 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.15s;
}
.qr__btn:hover {
  background: var(--c-bg);
  border-color: var(--c-brand);
  color: var(--c-brand);
  transform: translateX(2px);
}

.cp__typing {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px var(--sp-3);
  border-top: 1px solid var(--c-line);
}
.cp__typing span {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--c-brand);
  animation: typingDot 1.2s ease-in-out infinite;
}
.cp__typing span:nth-child(2) { animation-delay: 0.2s; }
.cp__typing span:nth-child(3) { animation-delay: 0.4s; }
@keyframes typingDot {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) { .cp__typing span { animation: none; } }

.cp__input-row {
  display: flex;
  gap: var(--sp-1);
  padding: var(--sp-2) var(--sp-3);
  border-top: 1px solid var(--c-line);
  background: var(--c-surface2);
}
.cp__input {
  flex: 1;
  background: var(--c-bg);
  border: 1px solid var(--c-line-2);
  border-radius: var(--r-btn);
  padding: 9px 12px;
  font-size: 0.8125rem;
  font-family: var(--font-body);
  color: var(--c-ink);
  outline: none;
  transition: border-color 0.2s;
}
.cp__input::placeholder { color: var(--c-muted); }
.cp__input:focus { border-color: var(--c-brand); }

.cp__send {
  width: 36px; height: 36px;
  background: var(--c-ink);
  color: var(--c-bg);
  border-radius: var(--r-btn);
  display: grid;
  place-items: center;
  cursor: pointer;
  flex-shrink: 0;
  transition: background 0.2s, filter 0.2s;
}
.cp__send:hover { background: var(--c-brand); }

@media (max-width: 480px) {
  .chat-panel { width: calc(100vw - var(--sp-4) * 2); }
  .fab__label { display: none; }
  .chat-fab { padding: 14px; border-radius: 50%; }
}
</style>
