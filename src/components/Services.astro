---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const { services } = t;
---
<section class="serv section" id="servicios" aria-labelledby="serv-heading">
  <div class="container">
    <header class="serv__header gsap-reveal">
      <span class="section-num mono">02 / <span data-i18n="nav.services">{t.nav.services}</span></span>
      <h2 id="serv-heading" class="section-h" data-i18n="services.heading">{services.heading}</h2>
      <p class="section-sub" data-i18n="services.sub">{services.sub}</p>
    </header>

    <div class="serv__grid gsap-stagger">
      {services.items.map((item, i) => (
        <article class={`tier ${('featured' in item && item.featured) ? 'tier--featured' : ''}`}>
          <header class="tier__head">
            <span class="tier__num mono">{item.tier}</span>
            {('featured' in item && item.featured) && (
              <span class="tier__badge mono">Más elegido</span>
            )}
          </header>

          <div class="tier__title">
            <h3 class="tier__name" data-i18n={`services.items.${i}.name`}>{item.name}</h3>
            <p class="tier__target" data-i18n={`services.items.${i}.target`}>{item.target}</p>
          </div>

          <p class="tier__desc" data-i18n={`services.items.${i}.desc`}>{item.desc}</p>

          <ul class="tier__includes">
            {item.includes.map((inc, ii) => (
              <li data-i18n={`services.items.${i}.includes.${ii}`}>
                <svg class="tier__check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{inc}</span>
              </li>
            ))}
          </ul>

          <footer class="tier__footer">
            <span class="tier__price mono" data-i18n={`services.items.${i}.price`}>{item.price}</span>
            <a href="#contacto" class={`tier__cta ${('featured' in item && item.featured) ? 'tier__cta--primary' : 'tier__cta--ghost'}`}>
              <span>Solicitar</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.serv {
  background: var(--c-bg);
  border-top: 1px solid var(--c-line);
}

.serv__header {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  max-width: 640px;
  margin-bottom: var(--sp-10);
}
.section-num {
  color: var(--c-brand);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: var(--text-label);
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.section-num::before {
  content: '';
  display: inline-block;
  width: 18px;
  height: 1px;
  background: var(--c-brand);
}

.serv__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--c-line);
  border: 1px solid var(--c-line);
  border-radius: var(--r-card);
  overflow: hidden;
}

.tier {
  background: var(--c-bg);
  padding: var(--sp-5) var(--sp-4);
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  position: relative;
  transition: background 0.25s var(--ease-out-quart);
}
.tier:hover { background: var(--c-surface); }

.tier--featured {
  background: var(--c-surface);
  position: relative;
}
.tier--featured::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--c-brand);
}

.tier__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  padding-bottom: var(--sp-2);
  border-bottom: 1px solid var(--c-line);
}
.tier__num {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  color: var(--c-muted);
  text-transform: uppercase;
}
.tier__badge {
  font-family: var(--font-mono);
  font-size: 0.625rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--c-brand);
  padding: 4px 8px;
  border: 1px solid var(--c-brand-line);
  border-radius: var(--r-mono);
  background: rgba(246,112,41,0.06);
}

.tier__title { display: flex; flex-direction: column; gap: 4px; }
.tier__name {
  font-size: clamp(1.5rem, 2.3vw, 1.875rem);
  font-weight: 600;
  color: var(--c-warm);
  letter-spacing: -0.024em;
  line-height: 1.1;
}
.tier__target {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.05em;
  color: var(--c-brand);
  text-transform: uppercase;
}
.tier__desc {
  font-size: var(--text-small);
  color: var(--c-ink-2);
  line-height: 1.65;
}

.tier__includes {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-top: var(--sp-2);
  border-top: 1px dashed var(--c-line);
  margin-top: var(--sp-1);
}
.tier__includes li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: var(--text-small);
  color: var(--c-ink-2);
  line-height: 1.5;
}
.tier__check {
  flex-shrink: 0;
  color: var(--c-brand);
  margin-top: 4px;
}

.tier__footer {
  margin-top: auto;
  padding-top: var(--sp-3);
  border-top: 1px solid var(--c-line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}
.tier__price {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--c-warm);
  letter-spacing: 0;
}

.tier__cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-display);
  font-size: var(--text-small);
  font-weight: 500;
  letter-spacing: 0.005em;
  padding: 9px 14px;
  border-radius: var(--r-btn);
  transition: gap 0.2s, filter 0.2s, background 0.2s, color 0.2s;
}
.tier__cta svg { transition: transform 0.2s; }
.tier__cta:hover svg { transform: translateX(2px); }

.tier__cta--ghost {
  background: transparent;
  color: var(--c-warm);
  border: 1px solid var(--c-line-2);
}
.tier__cta--ghost:hover {
  background: var(--c-surface2);
  border-color: var(--c-brand);
  color: var(--c-brand);
}
.tier__cta--primary {
  background: var(--c-brand);
  color: var(--c-bg);
}
.tier__cta--primary:hover {
  filter: brightness(1.1);
}

@media (max-width: 980px) {
  .serv__grid { grid-template-columns: 1fr; gap: 1px; }
}
</style>
